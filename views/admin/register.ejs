<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= first ? 'Setup Admin Pertama' : 'Tambah Admin' %> — Bukit Doa Getsemani</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="auth-page">
  <div class="auth-wrap">

    <div style="text-align:center;margin-bottom:2rem;">
      <% if (typeof siteLogo !== 'undefined' && siteLogo) { %>
        <img src="/uploads/<%= siteLogo %>" alt="Logo" style="height:64px;width:auto;object-fit:contain;margin:0 auto;display:block;">
      <% } else { %>
        <div class="auth-logo-placeholder"><span>Logo</span></div>
      <% } %>
      <p style="color:rgba(255,255,255,0.3);font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;margin-top:0.75rem;font-weight:600;">
        Bukit Doa Getsemani
      </p>
    </div>

    <div class="auth-card">
      <% if (first) { %>
        <h2>Setup Admin Pertama</h2>
        <p class="sub">Buat akun admin untuk mulai mengelola website.</p>
      <% } else { %>
        <h2>Tambah Admin Baru</h2>
        <p class="sub">Daftarkan akun admin baru.</p>
      <% } %>
      <div class="auth-divider"></div>

      <% if (error) { %><div class="auth-error"><%= error %></div><% } %>

      <form action="/admin/register" method="POST">
        <label class="form-label">Username</label>
        <input type="text" name="username" placeholder="Minimal 3 karakter" required minlength="3" maxlength="50" autocomplete="username">

        <label class="form-label">Email</label>
        <input type="email" name="email" placeholder="contoh: admin@bukitdoa.org" required autocomplete="email">

        <label class="form-label">Password</label>
        <input type="password" id="passwordInput" name="password" placeholder="Minimal 6 karakter" required autocomplete="new-password">
        <p class="password-hint" id="passwordHint"></p>

        <label class="form-label">Konfirmasi Password</label>
        <input type="password" id="confirmInput" name="confirm_password" placeholder="Ulangi password" required autocomplete="new-password">
        <p class="password-hint" id="confirmHint"></p>

        <button type="submit" class="btn-admin" style="width:100%;padding:13px;margin-top:0.5rem;font-size:0.92rem;">
          <%= first ? 'Buat Akun & Masuk' : 'Daftarkan Admin' %>
        </button>
      </form>
    </div>

    <div class="auth-link" style="margin-top:1rem;">
      <% if (!first) { %>
        <a href="/admin">Kembali ke Panel Admin</a>
      <% } else { %>
        <a href="/">Kembali ke Website</a>
      <% } %>
    </div>

  </div>
</div>
<script src="/js/admin.js"></script>
</body>
</html>
