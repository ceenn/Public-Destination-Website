<%- include('../../partials/admin-header', { pageTitle: 'Reservasi', activePage: 'reservasi' }) %>

<div style="display:flex;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap;">
  <div class="stat-card" style="flex:1;min-width:140px;">
    <div class="num"><%= total %></div>
    <div class="lbl">Total Reservasi</div>
  </div>
  <div class="stat-card" style="flex:1;min-width:140px;">
    <div class="num" style="color:#f59e0b;"><%= pending %></div>
    <div class="lbl">Menunggu Konfirmasi</div>
  </div>
  <div class="stat-card" style="flex:1;min-width:140px;">
    <div class="num" style="color:#10b981;"><%= confirmed %></div>
    <div class="lbl">Dikonfirmasi</div>
  </div>
</div>

<!-- Filter & Search -->
<div class="cms-card" style="padding:1.25rem 1.5rem;margin-bottom:1rem;">
  <form method="GET" action="/admin/reservasi" style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:flex-end;">
    <div style="flex:1;min-width:200px;">
      <label class="form-label" style="margin-bottom:0.35rem;">Cari (Nama / Kode / Telepon)</label>
      <input type="text" name="q" value="<%= search %>" placeholder="Ketik untuk mencari..." style="margin-bottom:0;">
    </div>
    <div style="min-width:160px;">
      <label class="form-label" style="margin-bottom:0.35rem;">Filter Status</label>
      <select name="status" style="margin-bottom:0;">
        <option value="">Semua Status</option>
        <option value="pending"   <%= status==='pending'   ?'selected':'' %>>Menunggu Konfirmasi</option>
        <option value="confirmed" <%= status==='confirmed' ?'selected':'' %>>Dikonfirmasi</option>
        <option value="cancelled" <%= status==='cancelled' ?'selected':'' %>>Dibatalkan</option>
        <option value="completed" <%= status==='completed' ?'selected':'' %>>Selesai</option>
      </select>
    </div>
    <button type="submit" class="btn-admin" style="padding:10px 20px;">Cari</button>
    <% if (search || status) { %>
    <a href="/admin/reservasi" class="btn-admin-outline" style="padding:10px 16px;">Reset</a>
    <% } %>
  </form>
</div>

<!-- Table -->
<div class="cms-card" style="padding:0;overflow:hidden;">
  <% if (reservations.length > 0) { %>
  <div style="overflow-x:auto;">
    <table class="cms-table" style="min-width:700px;">
      <thead>
        <tr>
          <th>Kode</th>
          <th>Nama</th>
          <th>Jenis Kunjungan</th>
          <th>Tanggal Masuk</th>
          <th>Peserta</th>
          <th>Status</th>
          <th>Daftar</th>
          <th style="width:1%;white-space:nowrap;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% reservations.forEach(r => { %>
        <%
          const statusMap = {
            pending:   { label:'Menunggu',    cls:'res-badge-pending'   },
            confirmed: { label:'Dikonfirmasi', cls:'res-badge-confirmed' },
            cancelled: { label:'Dibatalkan',   cls:'res-badge-cancelled' },
            completed: { label:'Selesai',      cls:'res-badge-completed' },
          };
          const st = statusMap[r.status] || { label: r.status, cls: '' };
        %>
        <tr>
          <td><code style="font-size:0.8rem;background:var(--gray-light);padding:2px 6px;border-radius:4px;"><%= r.reservation_code %></code></td>
          <td>
            <strong><%= r.full_name %></strong>
            <% if (r.church_org) { %><br><span style="font-size:0.76rem;color:var(--gray);"><%= r.church_org %></span><% } %>
          </td>
          <td style="font-size:0.84rem;max-width:180px;"><%= r.type_name || '-' %></td>
          <td style="font-size:0.84rem;white-space:nowrap;"><%= new Date(r.check_in).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %></td>
          <td style="text-align:center;"><%= r.group_size %></td>
          <td><span class="res-badge <%= st.cls %>"><%= st.label %></span></td>
          <td style="font-size:0.78rem;color:var(--gray);white-space:nowrap;"><%= new Date(r.created_at).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %></td>
          <td><a href="/admin/reservasi/<%= r.id %>" class="btn-admin-outline" style="padding:5px 12px;font-size:0.76rem;">Detail</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div style="text-align:center;padding:4rem 2rem;color:var(--gray);">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5" style="display:block;margin:0 auto 1rem;opacity:0.4;"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    <p style="font-weight:500;">Belum ada reservasi masuk.</p>
    <% if (search || status) { %><p style="font-size:0.85rem;margin-top:0.5rem;">Coba ubah filter pencarian.</p><% } %>
  </div>
  <% } %>
</div>

<div style="margin-top:1rem;text-align:right;">
  <a href="/admin/reservasi/settings/types" class="btn-admin-outline" style="font-size:0.82rem;">Kelola Jenis Reservasi</a>
</div>

<%- include('../../partials/admin-footer') %>
