<%- include('../../partials/admin-header', { pageTitle: 'Kelola Jenis Reservasi', activePage: 'reservasi' }) %>

<div style="margin-bottom:1rem;">
  <a href="/admin/reservasi" class="btn-admin-outline" style="font-size:0.82rem;padding:7px 14px;">← Kembali ke Daftar Reservasi</a>
</div>

<div class="add-form">
  <div class="add-form-title">Tambah Jenis Reservasi Baru</div>
  <form action="/admin/reservasi/settings/types/add" method="POST">
    <div class="inline-grid">
      <input type="text" name="name" placeholder="Nama jenis (contoh: Konseling Pastoral)" required>
      <input type="text" name="price_info" placeholder="Info biaya (contoh: Sukarela)">
    </div>
    <textarea name="description" placeholder="Deskripsi singkat..." rows="2"></textarea>
    <div class="inline-grid">
      <div>
        <label class="form-label">Minimal hari</label>
        <input type="number" name="min_days" value="1" min="1" style="margin-bottom:0;">
      </div>
      <div>
        <label class="form-label">Maksimal hari (kosongkan = tidak terbatas)</label>
        <input type="number" name="max_days" min="1" placeholder="Contoh: 3" style="margin-bottom:0;">
      </div>
    </div>
    <label class="toggle-switch" style="margin-top:0.75rem;">
      <input type="checkbox" name="requires_id" value="1">
      <span>Wajib menyerahkan KTP/SIM</span>
    </label>
    <div style="margin-top:1rem;">
      <button type="submit" class="btn-admin">Tambah Jenis</button>
    </div>
  </form>
</div>

<div class="cms-card">
  <div class="cms-card-title">Daftar Jenis Reservasi (<%= types.length %>)</div>
  <% types.forEach(t => { %>
  <div data-id="<%= t.id %>" style="border:1px solid var(--gray-light);border-radius:var(--radius-sm);padding:1.25rem;margin-bottom:0.75rem;">
    <form action="/admin/reservasi/settings/types/update/<%= t.id %>" method="POST">
      <div class="display-mode">
        <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;margin-bottom:0.4rem;">
          <strong style="font-size:0.95rem;"><%= t.name %></strong>
          <span class="<%= t.is_active ? 'badge-active' : 'badge-inactive' %>"><%= t.is_active ? 'Aktif' : 'Nonaktif' %></span>
          <span style="font-size:0.76rem;background:var(--gold-pale);color:#854F0B;padding:2px 8px;border-radius:100px;font-weight:600;"><%= t.price_info %></span>
          <% if (t.min_days || t.max_days) { %>
          <span style="font-size:0.76rem;color:var(--gray);">
            Min: <%= t.min_days || 1 %> hari<% if(t.max_days){ %> · Maks: <%= t.max_days %> hari<% } %>
          </span>
          <% } %>
        </div>
        <p style="font-size:0.85rem;color:var(--gray);"><%= t.description %></p>
        <p style="font-size:0.75rem;color:var(--gray);margin-top:0.3rem;">KTP wajib: <%= t.requires_id ? 'Ya' : 'Tidak' %></p>
      </div>
      <div class="edit-mode" style="display:none;">
        <div class="inline-grid" style="margin-bottom:0.5rem;">
          <input type="text" name="name" value="<%= t.name %>" style="margin-bottom:0;">
          <input type="text" name="price_info" value="<%= t.price_info %>" placeholder="Info biaya" style="margin-bottom:0;">
        </div>
        <textarea name="description" rows="2" style="margin-bottom:0.5rem;"><%= t.description %></textarea>
        <div class="inline-grid" style="margin-bottom:0.5rem;">
          <input type="number" name="min_days" value="<%= t.min_days||1 %>" min="1" placeholder="Min hari" style="margin-bottom:0;">
          <input type="number" name="max_days" value="<%= t.max_days||'' %>" min="1" placeholder="Maks hari (kosong=tidak terbatas)" style="margin-bottom:0;">
        </div>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:0.5rem;">
          <label class="toggle-switch"><input type="checkbox" name="requires_id" value="1" <%= t.requires_id?'checked':'' %>><span>Wajib KTP/SIM</span></label>
          <label class="toggle-switch"><input type="checkbox" name="is_active" value="1" <%= t.is_active?'checked':'' %>><span>Aktif</span></label>
        </div>
        <button type="submit" class="btn-admin" style="padding:7px 16px;font-size:0.82rem;">Simpan</button>
      </div>
      <div style="margin-top:0.75rem;display:flex;gap:0.5rem;">
        <button type="button" class="btn-admin-outline edit-toggle" data-editing="0" style="padding:5px 12px;font-size:0.76rem;">Edit</button>
      </div>
    </form>
    <form action="/admin/reservasi/settings/types/delete/<%= t.id %>" method="POST" style="display:inline;margin-left:0.5rem;">
      <button type="submit" class="btn-delete" onclick="return confirm('Hapus jenis <%= t.name %>?')" style="margin-top:0.5rem;">Hapus</button>
    </form>
  </div>
  <% }) %>
</div>

<%- include('../../partials/admin-footer') %>
