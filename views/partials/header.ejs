<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (typeof title !== 'undefined' ? title : (s.site_name || 'Bukit Doa Getsemani')) %></title>
  <meta name="description" content="<%= s.site_description || '' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar" id="navbar">
  <a href="/" class="nav-brand">
    <% if (s.site_logo) { %>
      <img src="/uploads/<%= s.site_logo %>" alt="<%= s.site_name %> Logo" class="nav-logo-img">
    <% } else { %>
      <div class="nav-logo-placeholder">
        <span>Logo</span>
      </div>
    <% } %>
    <div class="nav-brand-text">
      <span class="nav-brand-main"><%= s.site_name || 'Bukit Doa Getsemani' %></span>
      <span class="nav-brand-sub"><%= s.site_tagline || 'Ungaran' %></span>
    </div>
  </a>

  <ul class="nav-links">
    <% if (nav && nav.length > 0) { %>
      <% nav.forEach(link => { %>
        <li>
          <% const isContact = link.url === '#kontak'; %>
          <a href="<%= isContact ? '#' : link.url %>"
             <% if (isContact) { %>data-open="contact"<% } %>
             target="<%= isContact ? '' : link.target %>"
             <% if (!isContact && link.target === '_blank') { %>rel="noopener"<% } %>
             class="<%= link.is_button ? 'btn-kegiatan' : '' %>">
            <%= link.label %>
          </a>
        </li>
      <% }) %>
    <% } %>
    <li><a href="/admin" class="nav-admin-link">Admin</a></li>
  </ul>

  <button class="hamburger" id="hamburger" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mobile-nav" id="mobile-nav">
  <% if (nav && nav.length > 0) { %>
    <% nav.forEach(link => { %>
      <% const isContact = link.url === '#kontak'; %>
      <a href="<%= isContact ? '#' : link.url %>"
         <% if (isContact) { %>data-open="contact"<% } %>
         target="<%= isContact ? '' : link.target %>"
         <% if (!isContact && link.target==='_blank') { %>rel="noopener"<% } %>>
        <%= link.label %><%= (!isContact && link.target === '_blank') ? ' ↗' : '' %>
      </a>
    <% }) %>
  <% } %>
  <a href="/admin">Admin</a>
</div>

<div class="overlay" id="contactPopup">
  <div class="popup">
    <button class="popup-close" id="closeContact" aria-label="Tutup">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <h3>Hubungi Kami</h3>
    <div class="popup-divider"></div>
    <% if (s.contact_whatsapp) { %>
    <a href="https://wa.me/<%= s.contact_whatsapp %>" target="_blank" rel="noopener" class="contact-item">
      <div class="contact-item-icon" style="background:#d1fae5">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#059669"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      </div>
      <div class="contact-item-text"><span>WhatsApp</span><span>+<%= s.contact_whatsapp %></span></div>
    </a>
    <% } %>
    <% if (s.contact_instagram) { %>
    <a href="https://www.instagram.com/<%= s.contact_instagram %>" target="_blank" rel="noopener" class="contact-item">
      <div class="contact-item-icon" style="background:#fce7f3">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#db2777" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </div>
      <div class="contact-item-text"><span>Instagram</span><span>@<%= s.contact_instagram %></span></div>
    </a>
    <% } %>
    <% if (s.contact_youtube) { %>
    <a href="<%= s.contact_youtube %>" target="_blank" rel="noopener" class="contact-item">
      <div class="contact-item-icon" style="background:#fee2e2">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#dc2626"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </div>
      <div class="contact-item-text"><span>YouTube</span><span><%= s.site_name || 'Bukit Doa Getsemani' %></span></div>
    </a>
    <% } %>
    <div style="margin-top:1rem;padding:0.875rem;background:var(--gray-light);border-radius:var(--radius-sm);font-size:0.82rem;color:var(--gray);">
      <strong style="color:var(--black);font-weight:700;">Jam Operasional</strong><br>
      <%= s.hours_open || '05.00' %> – <%= s.hours_close || '22.00' %> WIB &nbsp;·&nbsp; <%= s.hours_note || 'Setiap hari' %>
    </div>
  </div>
</div>
