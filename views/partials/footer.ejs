<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-brand-identity">
          <% if (s.site_logo) { %>
            <img src="/uploads/<%= s.site_logo %>" alt="<%= s.site_name %> Logo" class="footer-logo-img">
          <% } else { %>
            <div class="footer-logo-placeholder"><span>Logo</span></div>
          <% } %>
          <span class="footer-brand-name"><%= s.site_name || 'Bukit Doa Getsemani' %></span>
        </div>
        <p><%= s.site_description || '' %></p>
        <div class="social-links" style="margin-top:1.25rem;">
          <% if(s.contact_instagram){ %>
          <a href="https://www.instagram.com/<%= s.contact_instagram %>" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <% } %>
          <% if(s.contact_youtube){ %>
          <a href="<%= s.contact_youtube %>" target="_blank" rel="noopener" aria-label="YouTube">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <% } %>
          <% if(s.contact_whatsapp){ %>
          <a href="https://wa.me/<%= s.contact_whatsapp %>" target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
          <% } %>
        </div>
      </div>
      <div>
        <p class="footer-title">Navigasi</p>
        <ul>
          <li><a href="/">Beranda</a></li>
          <li><a href="/sejarah">Sejarah</a></li>
          <li><a href="/fasilitas">Fasilitas</a></li>
          <li><a href="/tentang">Tentang Kami</a></li>
          <li><a href="/akses">Akses & Lokasi</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-title">Informasi</p>
        <ul>
          <li><a href="/tentang#jadwal">Jadwal Ibadah</a></li>
          <li><a href="/tentang#aturan">Aturan Berkunjung</a></li>
          <li><a href="/reservasi">Reservasi Kunjungan</a></li>
          <li><a href="/reservasi/cek">Cek Status Reservasi</a></li>
          <li><a href="#" data-open="contact">Kontak</a></li>
        </ul>
        <div style="margin-top:1.5rem;">
          <p class="footer-title">Alamat</p>
          <p style="color:rgba(255,255,255,0.5);font-size:0.84rem;line-height:1.8;white-space:pre-line;"><%= s.contact_address || '' %></p>
        </div>
      </div>
    </div>
    <hr class="footer-divider">
    <div class="footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> <%= s.footer_copyright || s.site_name %></span>
      <span><%= s.footer_tagline || '' %></span>
    </div>
  </div>
</footer>
<script src="/js/main.js"></script>
</body>
</html>
