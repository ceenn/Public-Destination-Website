<%- include('partials/header', { title: 'Sejarah - ' + s.site_name }) %>
<div style="margin-top:72px;">
  <div class="page-hero">
    <div class="container page-hero-content">
      <p class="section-label">Perjalanan Iman</p>
      <h1 class="page-title">Sejarah <%= s.site_name %></h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div style="max-width:760px;margin:0 auto;">

        <div class="fade-up" style="margin-bottom:4rem;">
          <p class="section-label">Awal Mula</p>
          <h2 style="margin-bottom:1.5rem;">Sebuah Kerinduan yang Tumbuh</h2>
          <p style="font-size:1.02rem;line-height:1.9;color:var(--gray);white-space:pre-line;"><%= s.sejarah_intro %></p>
        </div>

        <div class="fade-up" style="margin-bottom:4rem;">
          <p class="section-label">Garis Waktu</p>
          <h2 style="margin-bottom:2rem;">Tonggak Sejarah</h2>
          <div style="position:relative;padding-left:2rem;">
            <div style="position:absolute;left:0;top:8px;bottom:8px;width:2px;background:linear-gradient(to bottom,var(--gold),var(--gold-light));"></div>
            <% history.forEach((hi, i) => {
              const isLast = i === history.length - 1;
            %>
            <div style="position:relative;margin-bottom:2.5rem;" class="fade-up">
              <div style="position:absolute;left:-2.45rem;top:6px;width:14px;height:14px;border-radius:50%;background:<%= isLast?'var(--black)':'var(--gold)' %>;border:3px solid white;box-shadow:0 0 0 2px <%= isLast?'var(--black)':'var(--gold)' %>;"></div>
              <div style="background:<%= isLast?'var(--black)':'white' %>;border:<%= isLast?'none':'1px solid var(--gray-light)' %>;border-radius:var(--radius);padding:1.75rem;box-shadow:<%= isLast?'none':'0 2px 12px rgba(0,0,0,0.04)' %>;">
                <span style="font-size:2.2rem;font-weight:800;color:var(--gold);display:block;line-height:1;"><%= hi.year_label %></span>
                <h3 style="margin:0.5rem 0 0.75rem;font-size:1.05rem;color:<%= isLast?'white':'var(--black)' %>;"><%= hi.title %></h3>
                <p style="color:<%= isLast?'rgba(255,255,255,0.7)':'var(--gray)' %>;font-size:0.92rem;line-height:1.8;"><%= hi.content %></p>
              </div>
            </div>
            <% }) %>
          </div>
        </div>

        <div class="fade-up" style="background:var(--gold-pale);border-radius:var(--radius);padding:2.5rem;border-left:4px solid var(--gold);">
          <p class="section-label" style="margin-bottom:0.75rem;">Visi</p>
          <blockquote style="font-size:1.4rem;font-weight:700;font-style:italic;color:var(--black);line-height:1.5;margin:0 0 1rem;"><%= s.sejarah_vision_quote %></blockquote>
          <p style="font-size:0.82rem;color:var(--gold);letter-spacing:0.1em;text-transform:uppercase;font-weight:600;">— <%= s.sejarah_vision_source %></p>
          <p style="color:var(--gray);margin-top:1rem;font-size:0.92rem;line-height:1.8;"><%= s.sejarah_vision_desc %></p>
        </div>

      </div>
    </div>
  </section>
</div>
<%- include('partials/footer') %>
