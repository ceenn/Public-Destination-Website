<%- include('partials/header', { title: 'Akses & Lokasi - ' + s.site_name }) %>
<div style="margin-top:72px;">
  <div class="page-hero">
    <div class="container page-hero-content">
      <p class="section-label">Petunjuk Perjalanan</p>
      <h1 class="page-title">Akses & Lokasi</h1>
    </div>
  </div>

  <section style="padding:3rem 0;background:var(--gray-light);">
    <div class="container">
      <div style="border-radius:var(--radius);overflow:hidden;box-shadow:var(--glass-shadow);" class="fade-up">
        <iframe src="<%= s.contact_maps_embed %>" width="100%" height="480" style="display:block;border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Peta"></iframe>
      </div>
      <div style="display:flex;gap:1rem;margin-top:1.5rem;flex-wrap:wrap;" class="fade-up">
        <a href="<%= s.contact_maps_link %>" target="_blank" rel="noopener" class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Buka di Google Maps
        </a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:4rem;">
    <div class="container">
      <div class="section-header fade-up"><p class="section-label">Alamat Lengkap</p><h2>Lokasi Kami</h2></div>
      <div style="background:white;border:1px solid var(--gray-light);border-radius:var(--radius);padding:2.5rem;max-width:600px;border-left:4px solid var(--gold);" class="fade-up">
        <h3 style="margin-bottom:1rem;"><%= s.site_name %></h3>
        <p style="color:var(--gray);font-size:1rem;line-height:2;white-space:pre-line;"><%= s.contact_address %></p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:2rem;">
    <div class="container">
      <div class="section-header fade-up"><p class="section-label">Transportasi</p><h2>Cara Menuju <%= s.site_name %></h2></div>
      <div class="akses-grid">
        <% access.forEach(a => { %>
        <div class="akses-card fade-up">
          <h4>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="6" width="22" height="12" rx="2"/><path d="M8 6V4"/><path d="M16 6V4"/><path d="M1 12h22"/></svg>
            <%= a.transport_type %>
          </h4>
          <p><%= a.description %></p>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
</div>
<%- include('partials/footer') %>
